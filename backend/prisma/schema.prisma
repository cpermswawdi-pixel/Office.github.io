generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum RoleName {
  SUPER_ADMIN
  ADMIN
  STAFF
  WAREHOUSE_STAFF
  USER
}

enum MovementType {
  STOCK_IN
  STOCK_OUT
}

enum RequisitionStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
}

enum NotificationType {
  REQUISITION_CREATED
  REQUISITION_APPROVED
  REQUISITION_REJECTED
  REQUISITION_FULFILLED
}

model Role {
  id    Int      @id @default(autoincrement())
  name  RoleName @unique
  users User[]

  @@map("roles")
}

model User {
  id                    Int             @id @default(autoincrement())
  name                  String
  email                 String          @unique @db.VarChar(254)
  passwordHash          String
  roleId                Int
  role                  Role            @relation(fields: [roleId], references: [id])
  departmentId          Int?
  department            Department?     @relation(fields: [departmentId], references: [id])
  active                Boolean         @default(true)
  movements             StockMovement[]
  auditLogs             AuditLog[]
  requestedRequisitions Requisition[]   @relation("RequisitionRequester")
  decidedRequisitions   Requisition[]   @relation("RequisitionDecider")
  notifications         Notification[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([roleId])
  @@index([departmentId])
  @@map("users")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("categories")
}

model Supplier {
  id            Int             @id @default(autoincrement())
  name          String
  contactPerson String?
  phone         String?
  email         String?         @db.VarChar(254)
  address       String?         @db.Text
  notes         String?         @db.Text
  movements     StockMovement[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([name])
  @@map("suppliers")
}

model Department {
  id           Int             @id @default(autoincrement())
  name         String          @unique
  users        User[]
  movements    StockMovement[]
  requisitions Requisition[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@map("departments")
}

model Product {
  id               Int               @id @default(autoincrement())
  sku              String            @unique @db.VarChar(80)
  barcode          String?           @unique @db.VarChar(100)
  name             String            @db.VarChar(200)
  description      String?           @db.Text
  categoryId       Int
  category         Category          @relation(fields: [categoryId], references: [id])
  unit             String            @default("ชิ้น") @db.VarChar(30)
  unitCatalogId    Int?
  catalogUnit      Unit?             @relation(fields: [unitCatalogId], references: [id], onDelete: SetNull)
  costPrice        Decimal           @db.Decimal(14, 2)
  sellingPrice     Decimal           @db.Decimal(14, 2)
  stockQuantity    Int               @default(0)
  minimumStock     Int               @default(0)
  imageUrl         String?           @db.VarChar(500)
  movements        StockMovement[]
  requisitionItems RequisitionItem[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([name])
  @@index([categoryId])
  @@index([stockQuantity])
  @@index([unitCatalogId])
  @@map("products")
}

model Unit {
  id           Int       @id @default(autoincrement())
  name         String    @unique @db.VarChar(60)
  abbreviation String?   @db.VarChar(20)
  isActive     Boolean   @default(true)
  products     Product[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("units")
}

model Requisition {
  id            Int               @id @default(autoincrement())
  requestNumber String            @unique @db.VarChar(40)
  requesterId   Int
  requester     User              @relation("RequisitionRequester", fields: [requesterId], references: [id])
  departmentId  Int
  department    Department        @relation(fields: [departmentId], references: [id])
  purpose       String            @db.VarChar(500)
  status        RequisitionStatus @default(PENDING)
  decisionNote  String?           @db.VarChar(500)
  decidedById   Int?
  decidedBy     User?             @relation("RequisitionDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt     DateTime?
  items         RequisitionItem[]
  notifications Notification[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([requesterId, createdAt])
  @@index([status, createdAt])
  @@index([departmentId])
  @@map("requisitions")
}

model RequisitionItem {
  id            Int            @id @default(autoincrement())
  requisitionId Int
  requisition   Requisition    @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  productId     Int
  product       Product        @relation(fields: [productId], references: [id])
  quantity      Int
  movement      StockMovement?
  createdAt     DateTime       @default(now())

  @@unique([requisitionId, productId])
  @@index([productId])
  @@map("requisition_items")
}

model Notification {
  id            Int              @id @default(autoincrement())
  userId        Int
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  requisitionId Int?
  requisition   Requisition?     @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  type          NotificationType
  title         String           @db.VarChar(160)
  message       String           @db.VarChar(500)
  readAt        DateTime?
  createdAt     DateTime         @default(now())

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model StockMovement {
  id                Int              @id @default(autoincrement())
  type              MovementType
  productId         Int
  product           Product          @relation(fields: [productId], references: [id])
  quantity          Int
  unitCost          Decimal?         @db.Decimal(14, 2)
  documentNumber    String?
  movementDate      DateTime
  supplierId        Int?
  supplier          Supplier?        @relation(fields: [supplierId], references: [id])
  departmentId      Int?
  department        Department?      @relation(fields: [departmentId], references: [id])
  requesterName     String?          @db.VarChar(120)
  purpose           String?          @db.VarChar(500)
  notes             String?          @db.Text
  referenceKey      String?          @unique
  requisitionItemId Int?             @unique
  requisitionItem   RequisitionItem? @relation(fields: [requisitionItemId], references: [id], onDelete: SetNull)
  createdById       Int
  createdBy         User             @relation(fields: [createdById], references: [id])
  createdAt         DateTime         @default(now())

  @@index([type, movementDate])
  @@index([productId, movementDate])
  @@index([createdById])
  @@map("stock_movements")
}

model AuditLog {
  id            Int      @id @default(autoincrement())
  userId        Int?
  user          User?    @relation(fields: [userId], references: [id])
  username      String?
  action        String
  module        String
  recordId      String?
  previousValue Json?
  updatedValue  Json?
  ipAddress     String?
  createdAt     DateTime @default(now())

  @@index([module, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}
