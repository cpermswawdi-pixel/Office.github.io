{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../.env -- node --watch server.js",
    "start": "dotenv -e ../.env -- node server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "dotenv -e ../.env -- prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "dotenv -e ../.env -- node prisma/seed.js",
    "prisma:seed:deploy": "node prisma/seed.js",
    "test": "node --test"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "file-type": "^21.0.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pdfkit": "^0.17.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "prisma": "^6.19.0",
    "dotenv-cli": "^8.0.0"
  }
}
